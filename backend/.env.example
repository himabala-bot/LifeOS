# Django Secret Key (auto-generated by Render if using Blueprint)
DJANGO_SECRET_KEY=your-production-secret-key-replace-me

# Django Debug mode (False in production)
DJANGO_DEBUG=False

# Allowed Hosts
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# CORS Configuration for the Vercel Frontend
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000

# CSRF Trusted Origins
CSRF_TRUSTED_ORIGINS=https://*.vercel.app,https://*.onrender.com,http://localhost:3000

# Supabase PostgreSQL Connection String
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require
