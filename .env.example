# ==============================================================================
# LifeOS Split Deployment Environment Variables
# Frontend: Next.js (Vercel)
# Backend:  Django REST Framework + PostgreSQL (Render)
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend (Next.js / Vercel)
# ------------------------------------------------------------------------------
# URL of the deployed Django API on Render (e.g. https://lifeos-backend.onrender.com)
NEXT_PUBLIC_API_URL=https://lifeos-backend.onrender.com

# ------------------------------------------------------------------------------
# Backend (Django / Render)
# ------------------------------------------------------------------------------
# Random secure string for Django cryptographic signing (Auto-generated by Render)
DJANGO_SECRET_KEY=your-production-secret-key-replace-me

# Django Debug mode (False in production)
DJANGO_DEBUG=False

# Allowed Hosts (comma-separated, e.g. lifeos-backend.onrender.com,.onrender.com)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com

# Allowed CORS Origins for the Vercel Frontend
CORS_ALLOWED_ORIGINS=https://lifeos-app.vercel.app,http://localhost:3000

# Trusted CSRF Origins (for POST/PUT requests from Vercel domain)
CSRF_TRUSTED_ORIGINS=https://*.vercel.app,https://*.onrender.com,http://localhost:3000

# PostgreSQL Connection String (Automatically populated by Render Database)
# DATABASE_URL=postgresql://user:password@host:5432/lifeos?sslmode=require
