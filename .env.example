# ==========================================
# LifeOS Environment Variables Configuration
# ==========================================

# ------------------------------------------
# Backend (Django REST Framework) Settings
# ------------------------------------------
# Django Secret Key (Generate a random secure string for production)
DJANGO_SECRET_KEY=your-production-secret-key-change-this

# Django Debug mode (Set to False in production)
DJANGO_DEBUG=False

# Allowed hosts (Comma-separated, e.g. .vercel.app,yourdomain.com)
DJANGO_ALLOWED_HOSTS=*

# CORS & CSRF Configuration
CORS_ALLOW_ALL_ORIGINS=True
CSRF_TRUSTED_ORIGINS=https://*.vercel.app,http://localhost:3000,http://127.0.0.1:3000

# Database URL (Optional: defaults to SQLite if omitted; use Postgres in production, e.g. Neon, Supabase, Vercel Postgres)
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ------------------------------------------
# Frontend (Next.js) Settings
# ------------------------------------------
# Optional: External Backend API base URL if hosting backend on a dedicated domain
# NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000
